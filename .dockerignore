# The build context is the repository root, because the production image has to
# COPY the application in — an image built from `docker/php` alone cannot see
# `app/`. That makes this file load-bearing rather than a build-speed tweak.

# Secrets. `app/.env.local` holds the real credentials on the owner's machine,
# and `COPY app/ ./` would bake them into an image layer — where a later
# deletion does not remove them, because the layer keeps the file.
**/.env.local
**/.env.*.local

# Reinstalled inside the image from the lockfiles, so shipping the host copies
# would only overwrite the image's own with whatever the host happened to have.
app/vendor/
app/node_modules/
node_modules/

# Build products: `public/build` and `public/sw.js` are emitted by the `assets`
# stage, `var/` is generated by cache:warmup. A host copy of any of them would
# shadow the one the image built.
app/var/
app/public/build/
app/public/sw.js
# Generated by `assets:install`, which the prod stage runs itself. Letting a
# host copy in would make the image's API-doc assets depend on whether the
# machine that built it had ever run composer install.
app/public/bundles/

# Host-side material with nothing to contribute to a running container.
.git/
.github/
.idea/
.claude/
.playwright-mcp/
backups/
test-results/
tests-e2e/
