{% extends 'base.html.twig' %}

{% block title %}Muzyka — AIHomeManager{% endblock %}

{% block body %}
<div class="app">
    <header class="app-header">
        <h1 class="app-title">Muzyka</h1>
        <div class="header-actions">
            <select id="period-select" class="select-filter">
                <option value="7day">7 dni</option>
                <option value="1month" selected>1 miesiąc</option>
                <option value="3month">3 miesiące</option>
                <option value="6month">6 miesięcy</option>
                <option value="12month">12 miesięcy</option>
                <option value="overall">Cały okres</option>
            </select>
            <button class="btn btn-primary" id="btn-load-music">Wczytaj</button>
        </div>
    </header>

    <div id="music-loading" class="loading-overlay hidden">
        <div class="spinner"></div>
        <p>Pobieranie danych z Last.fm i Discogs…</p>
    </div>

    <div id="music-content" class="hidden">
        <div class="music-grid">
            <section class="card">
                <h2 class="section-title">Najlepsze albumy <small id="top-albums-period"></small></h2>
                <div id="top-albums-list"></div>
            </section>

            <section class="card">
                <h2 class="section-title">Kolekcja winyli</h2>
                <div id="collection-list"></div>
            </section>
        </div>

        <section class="card" style="margin-top:1rem">
            <div class="comparison-header">
                <h2 class="section-title">Porównanie</h2>
                <div class="match-score" id="match-score-badge"></div>
            </div>

            <div class="comparison-grid">
                <div>
                    <h3 class="subsection-title">Posiadane i odsłuchane</h3>
                    <div id="owned-list"></div>
                </div>
                <div>
                    <h3 class="subsection-title">Lista życzeń <small>(najczęściej słuchane, nieposiadane)</small></h3>
                    <div id="want-list"></div>
                </div>
                <div>
                    <h3 class="subsection-title">Zakurzona półka <small>(posiadane, rzadko słuchane)</small></h3>
                    <div id="dusty-list"></div>
                </div>
            </div>
        </section>
    </div>

    <section class="card" style="margin-top:1rem">
        <h2 class="section-title">Historia odsłuchu</h2>
        <form id="log-session-form" class="history-log-form">
            <input type="text" id="log-artist" placeholder="Wykonawca" required>
            <input type="text" id="log-title" placeholder="Tytuł" required>
            <input type="datetime-local" id="log-played-at" required>
            <input type="number" id="log-play-count" min="0" placeholder="Odtworzenia (opcjonalnie)">
            <button type="submit" class="btn btn-primary">Zapisz odtworzenie</button>
        </form>
        <div class="history-filters">
            <label>Od <input type="date" id="history-from"></label>
            <label>Do <input type="date" id="history-to"></label>
            <label>Źródło
                <select id="history-source">
                    <option value="">Wszystkie</option>
                    <option value="lastfm_scrobble">Last.fm scrobble</option>
                    <option value="lastfm_top_delta">Last.fm top delta</option>
                    <option value="manual">Ręcznie</option>
                </select>
            </label>
            <button class="btn btn-secondary" id="btn-load-history">Filtruj</button>
        </div>
        <div id="history-list"><div class="loading">Ładowanie…</div></div>
    </section>

    <div id="music-error" class="hidden"></div>
</div>

<script src="{{ asset('js/util.js') }}"></script>
<script src="{{ asset('js/music.js') }}"></script>
{% endblock %}
