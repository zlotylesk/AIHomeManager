{% extends 'base.html.twig' %}

{% block title %}Artykuły — AIHomeManager{% endblock %}

{% block body %}
<div class="app">
    <header class="app-header">
        <h1 class="app-title">Artykuły</h1>
        <div class="header-actions">
            <select id="filter-category" class="select-filter">
                <option value="">Wszystkie kategorie</option>
            </select>
            <select id="filter-status" class="select-filter">
                <option value="">Wszystkie statusy</option>
                <option value="unread">Nieprzeczytane</option>
                <option value="read">Przeczytane</option>
            </select>
            <button type="button" id="btn-export-csv" class="btn btn-secondary btn-sm">Eksportuj CSV</button>
            <button type="button" id="btn-export-pdf" class="btn btn-secondary btn-sm">Eksportuj PDF</button>
        </div>
    </header>

    <section class="card">
        <h2 class="section-title">Nowy artykuł</h2>
        <form id="form-create-article" class="time-report-form">
            <div class="form-group">
                <label for="article-title">Tytuł</label>
                <input id="article-title" type="text" maxlength="255" required>
            </div>
            <div class="form-group">
                <label for="article-url">URL</label>
                <input id="article-url" type="url" required>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="article-category">Kategoria</label>
                    <input id="article-category" type="text" maxlength="255">
                </div>
                <div class="form-group">
                    <label for="article-read-time">Czas czytania (min)</label>
                    <input id="article-read-time" type="number" min="1">
                </div>
                <div class="form-group form-group--action">
                    <button type="submit" class="btn btn-primary">Dodaj artykuł</button>
                </div>
            </div>
        </form>
    </section>

    <section class="card">
        <h2 class="section-title">Import z CSV / Pocket</h2>
        <form id="form-import-articles" class="time-report-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="import-file">Plik CSV</label>
                    <input id="import-file" type="file" accept=".csv,text/csv" required>
                </div>
                <div class="form-group">
                    <label for="import-encoding">Kodowanie</label>
                    <select id="import-encoding">
                        <option value="">Wykryj automatycznie</option>
                        <option value="UTF-8">UTF-8</option>
                        <option value="ISO-8859-2">ISO-8859-2</option>
                        <option value="Windows-1250">Windows-1250 (polski Windows)</option>
                        <option value="Windows-1252">Windows-1252</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="import-dry-run">Tryb testowy</label>
                    <input id="import-dry-run" type="checkbox">
                </div>
                <div class="form-group form-group--action">
                    <button type="submit" class="btn btn-primary">Importuj</button>
                </div>
            </div>
        </form>
        <div id="import-result" class="article-meta hidden"></div>
    </section>

    <div id="today-section" class="hidden">
        <h2 class="section-title">Artykuł na dziś</h2>
        <div id="today-article"></div>
    </div>

    <h2 class="section-title" style="margin-top:1.5rem">Wszystkie artykuły</h2>
    <div id="articles-list" class="articles-list">
        <div class="loading">Ładowanie…</div>
    </div>

    <div id="article-detail-modal" class="modal hidden">
        <div class="modal-box">
            <h2 id="detail-title"></h2>
            <div id="detail-body"></div>
            <button id="detail-close" class="btn btn-secondary">Zamknij</button>
        </div>
    </div>

    <div id="article-edit-modal" class="modal hidden">
        <div class="modal-box">
            <h2>Edytuj artykuł</h2>
            <form id="form-edit-article">
                <input type="hidden" id="edit-id">
                <div class="form-group">
                    <label for="edit-title">Tytuł</label>
                    <input id="edit-title" type="text" maxlength="255" required>
                </div>
                <div class="form-group">
                    <label for="edit-category">Kategoria</label>
                    <input id="edit-category" type="text" maxlength="255">
                </div>
                <div class="form-group">
                    <label for="edit-read-time">Czas czytania (min)</label>
                    <input id="edit-read-time" type="number" min="1">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Zapisz</button>
                    <button type="button" id="edit-cancel" class="btn btn-secondary">Anuluj</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="{{ asset('js/util.js') }}"></script>
<script src="{{ asset('js/articles.js') }}"></script>
{% endblock %}
