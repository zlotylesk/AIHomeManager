###< symfony/mailer ###

###> notifications ###
# Single-user system: every notification goes from one sender to one inbox.
# Override both in .env.local together with a real MAILER_DSN.
NOTIFICATIONS_MAIL_FROM=aihm@localhost
NOTIFICATIONS_MAIL_TO=owner@localhost
# Web Push (VAPID). Generate a key pair with:
#   php -r "require 'vendor/autoload.php'; var_dump(Minishlink\WebPush\VAPID::createVapidKeys());"
# Real values belong in .env.local — the public key is also handed to the browser
# when it subscribes (HMAI-283), the private key never leaves the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@localhost
###< notifications ###

###> spotify/podcasts ###
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/auth/spotify/callback
SPOTIFY_TOKEN_KEY=
###< spotify/podcasts ###

# Search engine (HMAI-360): app-data OpenSearch instance, separate from the Graylog log store.
SEARCH_ENGINE_DSN=http://search:9200
# Search backend flag (HMAI-361): "fulltext" (MySQL FULLTEXT) or "opensearch".
# Cut over to the engine in HMAI-366; FULLTEXT stays the one-line rollback and
# still answers automatically whenever the engine is unreachable (HMAI-365).
SEARCH_ENGINE_BACKEND=opensearch

# Search index alias (HMAI-362): reads and writes go through this name, so a
# reindex can point it at a freshly built index without a search outage.
SEARCH_INDEX_ALIAS=search_documents

###> frontend-security ###
# HMAI-404: the `main` firewall (frontend pages + /auth/* OAuth callbacks) now
# requires HTTP Basic - the page carries the API_KEY in a <meta> tag, so it can
# no longer stay anonymously readable. FRONTEND_PASSWORD_HASH below is a bcrypt
# hash of the literal word "test" - a placeholder, not a secret. Generate a real
# hash with `php bin/console security:hash-password` and keep it (with the real
# username) in .env.local only (gitignored) for production.
FRONTEND_USER=admin
FRONTEND_PASSWORD_HASH='$2y$12$mPPqtP8f9pnBizLapMu6QOCOwROl/NRkumyqobMmRdiQhZO2TUZJS'
###< frontend-security ###

# The single currency the Budget module is kept in. Multi-currency budgeting is
# deliberately unsupported: an amount in any other currency is rejected with 422
# rather than converted or silently relabelled, because there are no exchange
# rates, no per-category currency and no answer to what a mixed month's balance
# would even be denominated in. Unset or empty falls back to the container
# parameter app.budget.default_currency, so an environment that never heard of
# this variable still boots.
BUDGET_CURRENCY=PLN
