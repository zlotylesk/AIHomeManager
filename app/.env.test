# Search backend (HMAI-366): the suite stays on FULLTEXT even though the
# deployed default is now the engine. Most Search tests seed `search_documents`
# with SQL, and the CI e2e/newman jobs run no engine at all — inheriting the
# cutover would make them exercise a backend they are not set up for, or pass
# through the HMAI-365 fallback while proving nothing. The engine path is
# covered by the tests that boot it on purpose (SearchCutoverApiTest,
# OpenSearchEngineTest, SearchBackendFlagTest).
SEARCH_ENGINE_BACKEND=fulltext

# Frontend HTTP Basic (HMAI-404): a real, working test credential - its bcrypt
# hash verifies against the literal password "test". Unused by most of the
# suite (security.yaml's when@test sets `main.security: false` so the existing
# frontend-page / *AuthController tests keep working without adding
# credentials to every call site - see the security.yaml comment), but
# FrontendHttpBasicAuthTest boots the kernel in `dev` (where that override does
# not apply) and needs a real value.
FRONTEND_USER=admin
FRONTEND_PASSWORD_HASH='$2y$12$mPPqtP8f9pnBizLapMu6QOCOwROl/NRkumyqobMmRdiQhZO2TUZJS'

###> api-security-rotation ###
API_KEY_PREVIOUS='test-api-key-previous'
