# Development values. Every one of them.
#
# This file is TRACKED, and that is deliberate: Compose reads only `.env` from
# the project directory -- never `.env.local` -- so it is the single source of
# every variable the compose files interpolate, and a fresh clone has to come up
# with `make up` and nothing else.
#
# DO NOT PUT A PRODUCTION SECRET IN HERE. Not temporarily, not "just to test the
# deploy". The first reflexive `git add` carries it into the repository history,
# which is not somewhere a value can be taken back out of with one command --
# and a password that has been committed is a password that has to be rotated
# everywhere it was ever used.
#
# Production overrides these instead, from a gitignored `.env.local` beside this
# file: every `make prod-*` target reads `.env` first and `.env.local` second,
# and the second one wins. Nothing tracked is edited to deploy.
#
# The consequence of that layering is worth saying out loud, because it is the
# one that bites: a value MISSING from `.env.local` does not fail -- it falls
# through to the development value below and the stack comes up looking fine on
# a password that is printed in a public repository. `make doctor` compares the
# two files for exactly this and names every variable still on its dev value.
#
# docs/configuration.md lists what production must set, and how to generate each.

CONTAINER_PREFIX=homemanager
NGINX_PORT=8080
MYSQL_PORT=3306

# The database. MYSQL_USER and MYSQL_DATABASE are names rather than secrets and
# may stay as they are; both passwords must not.
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=homemanager
MYSQL_USER=homemanager
MYSQL_PASSWORD=homemanager

# Read by the GitHub MCP server on the host, not by any container. A personal
# access token is a real credential -- if you fill this in, fill it into
# `.env.local`, never here.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# Redis and the broker. These cannot live in `app/.env.local` like the
# application's own secrets do: Compose needs them while it is building the
# stack, before a container exists to read an application environment file.
REDIS_PASSWORD=homemanager
RABBITMQ_USER=homemanager
RABBITMQ_PASSWORD=homemanager

# Graylog, behind the `monitoring` profile. Compose interpolates every service
# in the file regardless of profile, so these must be set even on a stack that
# never starts it.
#
# GRAYLOG_ROOT_PASSWORD_SHA2 below is sha256("admin") -- the image's own default,
# which is to say no password at all. GRAYLOG_PASSWORD_SECRET is the pepper the
# session and user secrets are derived from; Graylog refuses to start on fewer
# than 16 characters.
GRAYLOG_PASSWORD_SECRET=somepasswordpepper
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
