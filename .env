CONTAINER_PREFIX=homemanager
NGINX_PORT=8080
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=homemanager
MYSQL_USER=homemanager
MYSQL_PASSWORD=homemanager
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
# Infrastructure credentials. These values are DEVELOPMENT values and are
# tracked on purpose, the same way MYSQL_* above are: a fresh clone has to come
# up without a setup step. Production does not use them -- `make prod-*` layers
# an untracked .env.local over this file, so the real broker and Redis
# passwords never live in the repository. See docs/configuration.md.
REDIS_PASSWORD=homemanager
RABBITMQ_USER=homemanager
RABBITMQ_PASSWORD=homemanager
